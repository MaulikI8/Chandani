{
  "name": "chandani-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:browser:dev": "CHANDANI_BROWSER_MODE=development node tests/browser.mjs",
    "test:development": "vite build --ssr tests/render-development.tsx --outDir test-results/development && NODE_ENV=development node test-results/development/render-development.js",
    "test:markup": "vite build --ssr tests/render-reference.tsx --outDir test-results/ssr && node test-results/ssr/render-reference.js && python3 tests/compare-markup.py"
  },
  "dependencies": {
    "embla-carousel-react": "^8.6.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.58.0",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.59.1",
    "pngjs": "6.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
